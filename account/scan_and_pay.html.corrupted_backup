  <script>
    // Global State
    let currentMerchantPhone = '';
    let currentMerchantVPA = '';
    let video = document.getElementById('qrVideo');
    let canvas = document.getElementById('qrCanvas');
    let ctx = canvas.getContext('2d');
    let stream = null;
    let scanning = false;

    // --- 1. Scanning Logic ---

    function openCamera() {
      document.getElementById('qrScannerModal').style.display = 'flex';
      startQRScanner();
    }

    function openGallery() {
      document.getElementById('photoFileInput').click();
    }

    function handlePhotoUpload(event) {
      const file = event.target.files[0];
      const statusDiv = document.getElementById('uploadStatus');

      if (!file) return;

      statusDiv.style.display = 'block';
      statusDiv.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
      statusDiv.style.color = '#1976D2';

      const reader = new FileReader();
      reader.onload = function (e) {
        const img = new Image();
        img.onload = function () {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          canvas.width = img.width;
          canvas.height = img.height;
          ctx.drawImage(img, 0, 0);
          const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: "dontInvert" });

          if (code) {
            statusDiv.innerHTML = '✅ QR Found!';
            statusDiv.style.color = 'green';
            setTimeout(() => {
              statusDiv.style.display = 'none';
              processQRCode(code.data);
            }, 800);
          } else {
            statusDiv.innerHTML = '❌ No QR code found';
            statusDiv.style.color = 'red';
            setTimeout(() => {
              statusDiv.style.display = 'none';
              processQRCode('');
            }, 1500);
          }
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    async function startQRScanner() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        video.srcObject = stream;
        video.setAttribute('playsinline', true);
        video.play();
        scanning = true;
        requestAnimationFrame(tick);
      } catch (err) {
        console.error("Camera error", err);
        alert("Could not access camera");
      }
    }

    function tick() {
      if (!scanning) return;
      if (video.readyState === video.HAVE_ENOUGH_DATA) {
        canvas.height = video.videoHeight;
        canvas.width = video.videoWidth;
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: "dontInvert" });

        if (code) {
          closeQRScanner();
          processQRCode(code.data);
          return;
        }
      }
      requestAnimationFrame(tick);
    }

    function closeQRScanner() {
      scanning = false;
      if (stream) {
        stream.getTracks().forEach(track => track.stop());
        stream = null;
      }
      document.getElementById('qrScannerModal').style.display = 'none';
    }

    // --- 2. Processing Logic ---

    function processQRCode(data) {
      console.log("QR Data:", data);

      let phone = '';
      let vpa = '';
      let merchantName = 'Merchant';

      if (data) {
        // Extract VPA from UPI URL
        if (data.includes('pa=')) {
          const urlParams = new URLSearchParams(data.split('?')[1]);
          vpa = urlParams.get('pa') || '';

          // Get merchant name if available
          const pn = urlParams.get('pn');
          if (pn) {
            merchantName = decodeURIComponent(pn);
          }

          // Try to extract phone from VPA if it starts with 10 digits
          if (vpa && vpa.includes('@')) {
            const vpaParts = vpa.split('@');
            if (vpaParts[0].match(/^\d{10}$/)) {
              phone = vpaParts[0];
            }
          }
        }

        // Fallback: Try to find any 10 digit number
        if (!phone) {
          const matches = data.match(/\d{10}/g);
          if (matches && matches.length > 0) {
            phone = matches[0];
          }
        }
      }

      showPaymentCard(phone, vpa, merchantName);
    }

    function showPaymentCard(phone, vpa, merchantName) {
      document.getElementById('scanSection').style.display = 'none';
      document.getElementById('paymentContainer').style.display = 'block';

      const phoneInputWrapper = document.getElementById('manualPhoneInputWrapper');
      const phoneInput = document.getElementById('merchantPhoneInput');
      const phoneDisplay = document.getElementById('displayMerchantPhone');
      const amountInput = document.getElementById('paymentAmount');
      const merchantNameDisplay = document.getElementById('displayMerchantName');
      const detectionMessage = document.getElementById('detectionMessage');

      currentMerchantPhone = phone;
      currentMerchantVPA = vpa;

      if (phone || vpa) {
        // SUCCESS: Either phone or VPA extracted
        merchantNameDisplay.textContent = merchantName;

        if (vpa) {
          phoneDisplay.textContent = vpa;
        } else {
          phoneDisplay.textContent = `+91 ${phone}`;
        }

